<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.invoice.ocr.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_digitalization']" position="inside">
                <setting id="account_invoice_ocr_ai_settings" string="Digitize Bills with AI"
                         help="Model used to read the bills uploaded from Vendors > Digitize Bills with AI. Its provider is configured in the AI settings.">
                    <field name="account_invoice_ocr_ai_llm_model"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
